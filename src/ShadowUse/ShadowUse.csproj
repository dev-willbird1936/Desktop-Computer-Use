<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ShadowUse</RootNamespace>
    <AssemblyName>dcu</AssemblyName>
    <Description>Desktop Computer Use (DCU): background Windows computer-use MCP server with UIA actions, window messages, a virtual cursor, and occluded-window capture.</Description>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.1.1</Version>
    <!-- Stamped into assembly metadata on every build; read back by RuntimeIdentification. Override with -p:BuildTimestampUtc=... for reproducible builds. -->
    <BuildTimestampUtc Condition="'$(BuildTimestampUtc)' == ''">$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'"))</BuildTimestampUtc>

    <!-- Attribution -->
    <Authors>dev-willbird1936</Authors>
    <Company>dev-willbird1936</Company>
    <Copyright>Copyright (c) 2026 dev-willbird1936</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dev-willbird1936/Desktop-Computer-Use</RepositoryUrl>

    <!-- Release hardening: no debug symbols, no local build paths in the binary -->
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <EnableCompressionInSingleFile Condition="'$(Configuration)' == 'Release'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
    <Content Include="..\..\tools\ui_candidate_detect.py" Link="tools\ui_candidate_detect.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShadowUse.Browser\ShadowUse.Browser.csproj" />
    <ProjectReference Include="..\ShadowUse.Jev\ShadowUse.Jev.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- F44: same release train as the core ModelContextProtocol package above (verified on
         nuget.org: both publish 1.4.1 together from the official MCP C# SDK). Only used when
         RemoteTransportUrl is explicitly configured; stdio remains the default transport. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

</Project>
